<properties>
    <!-- 0 = orbit tracker, 1 = targeting, 2 = radar -->
    <property id="Style" type="number">0</property>
    <!-- palette indices, see source/Palette.mc (0 green ... 3 red ... 9 purple) -->
    <property id="Theme" type="number">0</property>
    <property id="Accent" type="number">3</property>
    <property id="Planet" type="number">3</property>
    <!-- field types, see source/Fields.mc (0 HR, 1 battery, ... 8 steps, 9 none, 10 seconds, 11 sunrise/sunset, 12 intensity minutes, 13 altitude) -->
    <property id="Field1" type="number">0</property>
    <property id="Field2" type="number">1</property>
    <property id="Field3" type="number">8</property>
    <!-- small seconds after HH:MM while the screen is awake -->
    <property id="ShowSeconds" type="boolean">false</property>
    <!-- optional looks: slanted seven-segment digits, CRT glow and scanlines -->
    <property id="SlantDigits" type="boolean">false</property>
    <property id="CrtGlow" type="boolean">false</property>
</properties>
